# PostgreSQL already provisioned; use the CA options required by your provider.
DB_URL=jdbc:postgresql://db.example.com:5432/wasap?sslmode=verify-full&sslfactory=org.postgresql.ssl.DefaultJavaSSLFactory
DB_USER=wasap
# Password is read from this local file; do not put it in the Docker image.
DB_PASSWORD_PATH=./certs/db-password
SERVER_PORT=5050
APP_TIMEZONE=America/Mexico_City
WASAP_UID=1000
WASAP_GID=1000
