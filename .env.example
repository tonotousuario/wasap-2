# PostgreSQL already provisioned; use the CA options required by your provider.
DB_URL=jdbc:postgresql://db.example.com:5432/wasap?sslmode=verify-full&sslfactory=org.postgresql.ssl.DefaultJavaSSLFactory
DB_USER=wasap
# Password is read from this local file; do not put it in the Docker image.
DB_PASSWORD_PATH=./certs/db-password
SERVER_PORT=5050
PANEL_ENABLED=true
PANEL_PORT=5443
DB_POOL_SIZE=20
MAX_CONNECTIONS=2500
# Optional, comma separated: addresses the container cannot see (host LAN IPs, DNS names
# are added with --dns). Proposed first when issuing the server certificate.
SERVER_PUBLIC_ADDRESSES=
APP_TIMEZONE=America/Mexico_City
# Days to keep idempotency records of processed requests (minimum 1).
PROCESSED_REQUEST_RETENTION_DAYS=30
WASAP_UID=1000
WASAP_GID=1000
